# ================================
# DJANGO SETTINGS
# ================================
SECRET_KEY=django-insecure-change-this-to-something-very-secure-in-production-xyz123abc456
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ================================
# DATABASE (Docker PostgreSQL)
# ================================
# Estos valores DEBEN coincidir con tu docker-compose.yml
DB_NAME=autotaller_db
DB_USER=autotaller_user
DB_PASSWORD=superpass123
DB_HOST=db
DB_PORT=5432

# ================================
# CORS (Frontend)
# ================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ================================
# NOTAS IMPORTANTES
# ================================
# - DB_HOST=db porque es el nombre del servicio en docker-compose
# - Si corres Django SIN Docker, cambia DB_HOST=localhost
# - En producción cambia DEBUG=False y genera un SECRET_KEY seguro